// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Legacy Models (Preserved for 100% Backward Compatibility) ────────────────
model AppliedJob {
  id                 String   @id @default(uuid())
  company            String
  role               String
  location           String?
  jobUrl             String   @unique
  appliedAt          DateTime @default(now())
  status             String   @default("PENDING") // PENDING, SUCCESS, FAILED, SKIPPED
  recruiterQuestions Json?    // Array of questions found
  aiAnswers          Json?    // Array of answers submitted
  errorMessage       String?
  matchScore         Int?
  externalUrl        String?  // URL for manual external application
  
  @@index([jobUrl])
  @@index([appliedAt])
}

model JobLog {
  id        String   @id @default(uuid())
  event     String   // LOGIN, SEARCH, APPLY, ERROR, CAPTCHA
  timestamp DateTime @default(now())
  metadata  Json?    // Extra info like jobUrl, error details, etc.
  
  @@index([timestamp])
}

// ─── Multi-Source Enterprise Automation Models ────────────────────────────────

enum PlatformSource {
  NAUKRI
  LINKEDIN
  WELLFOUND
  WHATSAPP
}

enum ApplicationStatus {
  DISCOVERED
  ELIGIBLE
  INELIGIBLE
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

model Job {
  id              String         @id @default(uuid())
  fingerprint     String         @unique
  source          PlatformSource @default(NAUKRI)
  sourceJobId     String?
  sourceUrl       String
  applicationUrl  String
  applicationType String         @default("UNKNOWN") // NATIVE, EXTERNAL_ATS, DIRECT_URL, UNKNOWN
  title           String
  company         String
  locations       String[]
  isRemote        Boolean        @default(false)
  minExperience   Int            @default(0)
  maxExperience   Int            @default(30)
  skills          String[]
  description     String?
  postedAge       String?
  discoveredAt    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  applications    Application[]

  @@index([source])
  @@index([company])
  @@index([title])
  @@index([discoveredAt])
}

model Application {
  id             String            @id @default(uuid())
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(PENDING)
  appliedAt      DateTime?
  resumeUsed     String?
  matchScore     Int?
  failureReason  String?
  notes          String?
  qaSnapshot     Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attempts       ApplicationAttempt[]

  @@index([jobId])
  @@index([status])
  @@index([appliedAt])
}

model ApplicationAttempt {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attemptNumber Int         @default(1)
  status        String      // SUCCESS, FAILED, SKIPPED
  message       String?
  errorDetails  String?
  attemptedAt   DateTime    @default(now())

  @@index([applicationId])
  @@index([attemptedAt])
}
