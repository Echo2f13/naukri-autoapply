# PostgreSQL Database connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/naukri_autoapply?schema=public"

# AI Provider API Keys
GEMINI_API_KEY="your_gemini_api_key_here"

# Local AI settings (LMStudio / Ollama)
LMSTUDIO_BASE_URL="http://localhost:1234"
LMSTUDIO_MODEL="gemma-4-e4b"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=""

# Candidate and Automation Settings
RESUME_PATH="./resume/resume.pdf"
MAX_DAILY_APPLICATIONS=30
HEADLESS=false
BROWSER_SLOW_MO=0
AUTH_DIR="./auth"
BROWSER_CHANNEL="msedge"

# Workday Credentials (Optional / Automated portal logins)
WORKDAY_USERNAME="your_email@example.com"
WORKDAY_PASSWORD="your_secure_password"

# Optional Channel URLs
WHATSAPP_CHANNEL_URL="https://whatsapp.com/channel/your_channel_id"
